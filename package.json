{
  "name": "aperture-tunes",
  "version": "1.2.0",
  "description": "Personal music tagger: identifies songs online and fixes tags, cover art and filenames",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "electron-builder --win"
  },
  "keywords": [],
  "author": "M33RK4",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "express": "^5.3.0",
    "flac-tagger": "^2.1.0",
    "multer": "^2.5.0",
    "music-metadata": "^12.3.2",
    "node-id3": "^0.2.9"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "productName": "Aperture Tunes",
  "build": {
    "appId": "local.aperture.tunes",
    "productName": "Aperture Tunes",
    "files": [
      "main.js",
      "preload.cjs",
      "server.js",
      "lib/**",
      "public/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Aperture Tunes",
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "artifactName": "Aperture Tunes Setup.exe"
    },
    "portable": {
      "artifactName": "Aperture Tunes Portable.exe"
    },
    "copyright": "Copyright © 2026 M33RK4"
  }
}
